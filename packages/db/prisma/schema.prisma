generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DocumentType {
  id         String  @id @default(cuid())
  name       String  @unique
  isRequired Boolean @default(false) @map("is_required")

  @@map("document_type")
}

model ActivityType {
  id   String @id @default(uuid())
  name String @unique

  @@map("activity_type")
}
