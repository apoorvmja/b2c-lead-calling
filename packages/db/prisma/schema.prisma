generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DocumentType {
  id         String  @id @default(cuid())
  name       String  @unique
  isRequired Boolean @default(false) @map("is_required")

  @@map("document_type")
}

model ActivityType {
  id   String @id @default(uuid())
  name String @unique

  @@map("activity_type")
}

model User {
  id               String    @id @default(uuid())
  fullName         String    @map("full_name")
  phone            String    @unique
  email            String    @unique
  password         String
  role             String
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  assignedStudents Student[]

  @@map("user")
}

model Student {
  id               String    @id @default(uuid())
  enrollmentNumber String    @unique @map("enrollment_number")
  enrollmentDate   DateTime  @map("enrollment_date")
  firstName        String    @map("first_name")
  middleName       String?   @map("middle_name")
  surname          String
  phone            String
  email            String?
  address          String?
  birthDate        DateTime? @map("birth_date")
  country          String
  emergencyName    String?   @map("emergency_name")
  emergencyPhone   String?   @map("emergency_phone")
  emergencyEmail   String?   @map("emergency_email")
  source           String
  purpose          String?
  interestedField  String?   @map("interested_field")
  status           String

  assignedToUserId String?   @map("assigned_to_user_id")
  assignedToUser   User?     @relation(fields: [assignedToUserId], references: [id])
  
  intake           String
  details          String?
  englishTest      String?   @map("english_test")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  followUps        StudentFollowUp[]

  @@map("student")
}

model StudentFollowUp {
  id           String    @id @default(uuid())

  studentId    String    @map("student_id")
  student      Student   @relation(fields: [studentId], references: [id])
  
  status       String
  remarks      String?
  followUp     Boolean   @default(false) @map("follow_up")
  followUpDate DateTime? @map("follow_up_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("student_follow_up")
}
