generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  phone     String   @unique
  email     String   @unique
  password  String
  role      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedLeads Lead[]

  @@map("user")
}

model Lead {
  id      String  @id @default(uuid())
  name    String
  phone   String
  email   String?
  address String?
  source  String

  assignedToUserId String? @map("assigned_to_user_id")
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id])

  interestedField String? @map("interested_field")
  country         String?
  purpose         String?
  status          String
  englishTest     String? @map("english_test")

  isConverted      Boolean   @default(false) @map("is_converted")
  convertedAt      DateTime? @map("converted_at")
  convertedStudent Student?  @relation("LeadConversion")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  history LeadHistory[]

  @@map("lead")
}

model LeadHistory {
  id String @id @default(uuid())

  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status       String
  activity     String
  remarks      String?
  followUp     Boolean   @default(false) @map("follow_up")
  followUpDate DateTime? @map("follow_up_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("lead_history")
}

model Student {
  id               String    @id @default(uuid())

  leadId           String    @unique @map("lead_id")
  lead             Lead      @relation("LeadConversion", fields: [leadId], references: [id])
  
  enrollmentNumber String    @unique @map("enrollment_number")
  enrollmentDate   DateTime  @map("enrollment_date")
  firstName        String    @map("first_name")
  middleName       String?   @map("middle_name")
  surname          String
  birthDate        DateTime? @map("birth_date")
  emergencyName    String?   @map("emergency_name")
  emergencyPhone   String?   @map("emergency_phone")
  emergencyEmail   String?   @map("emergency_email")
  status           String

  intake    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  followUps    StudentFollowUp[]
  applications StudentApplication[]
  visas        StudentVisa[]

  @@map("student")
}

model StudentFollowUp {
  id String @id @default(uuid())

  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id])

  status       String
  remarks      String?
  followUp     Boolean   @default(false) @map("follow_up")
  followUpDate DateTime? @map("follow_up_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("student_follow_up")
}

model StudentApplication {
  id String @id @default(uuid())

  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  preferredCountry String? @map("preferred_country")
  college          String?
  course           String?
  courseDuration   String? @map("course_duration")

  fee Decimal?

  referencePortal     String? @map("reference_portal")
  referencePortalLink String? @map("reference_portal_link")

  applicationNo     String?   @unique @map("application_no")
  applicationDate   DateTime? @map("application_date")
  applicationStatus String    @default("Application In Progress") @map("application_status")
  intake            String?

  admissionDone Boolean @default(false) @map("admission_done")

  applicationRemark String? @map("application_remark")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  updates ApplicationUpdate[]

  @@map("student_application")
}

model ApplicationUpdate {
  id String @id @default(uuid())

  applicationId String             @map("application_id")
  application   StudentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status  String
  remarks String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("application_update")
}

model StudentVisa {
  id String @id @default(uuid())

  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  country String?

  visaType   String  @map("visa_type")
  visaNumber String? @unique @map("visa_number")
  visaDone   Boolean @default(false) @map("visa_done")

  status String @default("Not Started")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  updates StudentVisaUpdate[]

  @@map("student_visa")
}

model StudentVisaUpdate {
  id String @id @default(uuid())

  visaId String      @map("visa_id")
  visa   StudentVisa @relation(fields: [visaId], references: [id], onDelete: Cascade)

  status  String
  remarks String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("student_visa_update")
}
